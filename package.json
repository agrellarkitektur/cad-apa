{
  "name": "bacchus",
  "private": true,
  "version": "0.10.32",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "preview:artifact": "tsc && vite build --mode artifact && node scripts/artifact.mjs",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/three": "^0.170.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "earcut": "^3.0.1",
    "pdfjs-dist": "^6.4.299",
    "polygon-clipping": "^0.15.7",
    "three": "^0.170.0"
  },
  "license": "GPL-3.0-or-later"
}
